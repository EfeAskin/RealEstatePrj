# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# Required — PostgreSQL connection string (Neon: Dashboard -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Optional — enables AI semantic search, recommendations and the AI chat.
# Without it the app still runs and search falls back to keyword matching.
OPENAI_API_KEY=

# Optional — model / behaviour overrides (defaults shown)
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini
# LLM_RERANK=1
# RELEVANCE_GATE=1

# Optional — direct (non-pooled) URL used by scripts/run_migration.py for DDL
# DATABASE_URL_DIRECT=
